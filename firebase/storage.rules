rules_version = '2';

// Legacy read-only storage.
//
// New thumbnails are uploaded to Cloudinary through the client-side unsigned
// preset (see client/src/lib/cloudinary.js). The site no longer exposes a
// Firebase Storage picker or upload path. Existing Firebase Storage images are
// kept readable so old resource cards do not break; all new writes are denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
