rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    // Composite id convention: "<ownerUid>_<resourceId>".
    function ownedDocId(uid, resourceId) {
      return uid + '_' + resourceId;
    }

    // ---------- resources ----------
    // Published resources are public. Pending/rejected resources are visible
    // only to their submitter and to admins. Only admins may publish, edit,
    // feature, or delete a listing. Reports about resources live in /reports.
    match /resources/{resourceId} {
      allow read: if
        (resource.data.status == 'published') ||
        isAdmin() ||
        (isSignedIn() && resource.data.createdBy == request.auth.uid);

      allow create: if
        isSignedIn() &&
        request.resource.data.id == resourceId &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.featured == false &&
        request.resource.data.type in ['course', 'book', 'software'] &&
        // Refined per-language model: title/description are { en, bn?, ur? }.
        request.resource.data.title is map &&
        request.resource.data.title.en is string &&
        request.resource.data.title.en.size() >= 3 &&
        request.resource.data.title.en.size() <= 160 &&
        request.resource.data.description is map &&
        request.resource.data.description.en is string &&
        request.resource.data.description.en.size() >= 40 &&
        request.resource.data.description.en.size() <= 2000 &&
        isNonEmptyString(request.resource.data.sourceName) &&
        request.resource.data.sourceName.size() <= 160 &&
        isNonEmptyString(request.resource.data.sourceUrl) &&
        request.resource.data.sourceUrl.matches('^https://.*') &&
        isNonEmptyString(request.resource.data.license) &&
        request.resource.data.license.size() <= 160 &&
        request.resource.data.language is list &&
        request.resource.data.language.size() > 0 &&
        request.resource.data.countries is list &&
        request.resource.data.countries.size() > 0 &&
        (!('licenseUrl' in request.resource.data) ||
          request.resource.data.licenseUrl == null ||
          request.resource.data.licenseUrl.matches('^https://.*')) &&
        (!('thumbnailUrl' in request.resource.data) ||
          request.resource.data.thumbnailUrl == null ||
          request.resource.data.thumbnailUrl is string);

      allow update, delete: if isAdmin();
    }

    // ---------- categories & alternatives (admin-managed) ----------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /alternatives/{alternativeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- user profiles ----------
    // A user can read and edit only their own profile. `role` is never a
    // client-writable field: admin access comes from the `admin` custom claim
    // (see server/scripts/set-admin.js), and owners cannot change any role.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if
        isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.get('role', 'user') == 'user' &&
        (!('displayName' in request.resource.data) ||
          request.resource.data.displayName.size() <= 80) &&
        (!('preferredLanguage' in request.resource.data) ||
          request.resource.data.preferredLanguage in ['en', 'bn', 'ur']);

      allow update: if
        isAdmin() ||
        (
          isOwner(userId) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.get('role', 'user') == resource.data.get('role', 'user')
        );

      // Owners may delete their own account (the delete-account flow).
      allow delete: if isOwner(userId) || isAdmin();

      // Legacy personal saved resources. Private to the owner.
      match /bookmarks/{resourceId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---------- bookmarks (userId_resourceId) ----------
    match /bookmarks/{bookmarkId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if
        isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.id == bookmarkId &&
        bookmarkId == ownedDocId(request.auth.uid, request.resource.data.resourceId);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ---------- progress (userId_resourceId) ----------
    match /progress/{progressId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if
        isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        progressId == ownedDocId(request.auth.uid, request.resource.data.resourceId);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------- saved AI roadmaps (owner-only) ----------
    // A roadmap generated by LearnMate that the learner chose to keep. Only the
    // owner can read or delete it; content is bounded so a document stays small.
    match /roadmaps/{roadmapId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if
        isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isNonEmptyString(request.resource.data.goal) &&
        request.resource.data.goal.size() <= 300 &&
        isNonEmptyString(request.resource.data.title) &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.steps is list &&
        request.resource.data.steps.size() <= 20;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ---------- reviews ----------
    // Anyone can read published reviews. Signed-in, email-verified users may
    // post exactly one review per resource, edit it, or delete their own.
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if
        isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.resource.data.userId == request.auth.uid &&
        reviewId == ownedDocId(request.resource.data.resourceId, request.auth.uid) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        isNonEmptyString(request.resource.data.body) &&
        request.resource.data.body.size() <= 2000;

      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------- reports ----------
    // Reports are created by the Express API with the Admin SDK (which bypasses
    // these rules), so the public client can never write here. Admins review
    // reports from the moderation dashboard.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ---------- server-only settings ----------
    // The Gemini API key and model live in settings/ai and are written by the
    // Express API with the Admin SDK (which bypasses these rules). Clients can
    // never read or write anything under settings/.
    match /settings/{documentId} {
      allow read, write: if false;
    }

    // ---------- default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
