rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Administrator status comes exclusively from the `admin: true` custom
      // claim, set with server/scripts/set-admin.js. It is never read from a
      // Firestore field, so a user can never promote themselves.
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    // Key whitelist that tolerates older documents: on create every key must
    // be listed; on update only the keys being added or changed must be.
    function writesOnly(keys) {
      return resource == null
        ? request.resource.data.keys().hasOnly(keys)
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isOptionalString(data, field, max) {
      return !(field in data) || data[field] == null ||
        (data[field] is string && data[field].size() <= max);
    }

    // Composite id convention: "<ownerUid>_<resourceId>".
    function ownedDocId(uid, resourceId) {
      return uid + '_' + resourceId;
    }

    // ---------- resources ----------
    // Anyone can read published listings. Administrators (custom claim
    // `admin: true`) can read every listing regardless of status, which is what
    // the admin panel needs for drafts, pending submissions, and flagged items.
    // Submitters can still see their own pending/rejected entry. Only admins
    // may publish, edit, feature, or delete a listing.
    match /resources/{resourceId} {
      allow read: if
        isAdmin() ||
        (resource.data.status == 'published') ||
        (isSignedIn() && resource.data.createdBy == request.auth.uid);

      // Community submissions only. The key whitelist stops a submitter from
      // pre-filling counters (ratingAvg, viewCount…) or moderation fields.
      allow create: if
        isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'id', 'type', 'title', 'slug', 'sourceName', 'description', 'longDescription',
          'sourceUrl', 'category', 'level', 'language', 'countries', 'tags', 'license',
          'licenseUrl', 'author', 'platform', 'featured', 'thumbnailUrl', 'status',
          'createdBy', 'creatorEmail', 'lastVerified', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.id == resourceId &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.featured == false &&
        request.resource.data.type in ['course', 'book', 'software'] &&
        // Refined per-language model: title/description are { en, bn?, ur? }.
        request.resource.data.title is map &&
        request.resource.data.title.en is string &&
        request.resource.data.title.en.size() >= 3 &&
        request.resource.data.title.en.size() <= 160 &&
        request.resource.data.description is map &&
        request.resource.data.description.en is string &&
        request.resource.data.description.en.size() >= 40 &&
        request.resource.data.description.en.size() <= 2000 &&
        isNonEmptyString(request.resource.data.sourceName) &&
        request.resource.data.sourceName.size() <= 160 &&
        isNonEmptyString(request.resource.data.sourceUrl) &&
        request.resource.data.sourceUrl.matches('^https://.*') &&
        isNonEmptyString(request.resource.data.license) &&
        request.resource.data.license.size() <= 160 &&
        request.resource.data.language is list &&
        request.resource.data.language.size() > 0 &&
        request.resource.data.countries is list &&
        request.resource.data.countries.size() > 0 &&
        (!('licenseUrl' in request.resource.data) ||
          request.resource.data.licenseUrl == null ||
          request.resource.data.licenseUrl.matches('^https://.*')) &&
        (!('thumbnailUrl' in request.resource.data) ||
          request.resource.data.thumbnailUrl == null ||
          request.resource.data.thumbnailUrl is string) &&
        isOptionalString(request.resource.data, 'category', 60) &&
        isOptionalString(request.resource.data, 'author', 120) &&
        isOptionalString(request.resource.data, 'slug', 120) &&
        (!('tags' in request.resource.data) ||
          (request.resource.data.tags is list && request.resource.data.tags.size() <= 10));

      // Every change after submission goes through the admin API (audited,
      // blocklist-checked, counters reset). Direct browser writes are denied
      // even for admins, so a revoked admin token cannot be used here either.
      allow update, delete: if false;

      // YouTube lessons are stored in a subcollection so long playlists do not
      // hit Firestore's 1 MiB document limit. Only the Admin SDK (Express API)
      // writes them. Readers inherit the parent resource's visibility: public
      // for published courses, plus admins and the original submitter.
      match /videos/{lessonId} {
        allow read: if
          isAdmin() ||
          get(/databases/$(database)/documents/resources/$(resourceId)).data.status == 'published' ||
          (
            isSignedIn() &&
            get(/databases/$(database)/documents/resources/$(resourceId)).data.createdBy == request.auth.uid
          );
        allow write: if false;
      }
    }

    // ---------- categories & alternatives (server-managed) ----------
    // Reads are public; writes go exclusively through the admin API, which
    // validates input, keeps slugs/order consistent and writes an audit entry.
    // Direct browser writes are denied even for admins.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /alternatives/{alternativeId} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- user profiles ----------
    // A user can read and edit only their own profile. `role` is never a
    // client-writable field: admin access comes from the `admin` custom claim
    // (see server/scripts/set-admin.js), and owners cannot change any role.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      function validProfile(data) {
        return writesOnly([
            'uid', 'email', 'displayName', 'photoURL', 'provider',
            'preferredLanguage', 'createdAt', 'lastLoginAt', 'emailVerified'
          ]) &&
          data.get('uid', userId) == userId &&
          isOptionalString(data, 'email', 200) &&
          isOptionalString(data, 'displayName', 80) &&
          isOptionalString(data, 'photoURL', 600) &&
          isOptionalString(data, 'provider', 40) &&
          (!('preferredLanguage' in data) || data.preferredLanguage in ['en', 'bn', 'ur']) &&
          (!('emailVerified' in data) || data.emailVerified is bool);
      }

      allow create: if isOwner(userId) && validProfile(request.resource.data);

      // `createdAt` is fixed once written. Admin edits go through the API.
      allow update: if
        isOwner(userId) &&
        validProfile(request.resource.data) &&
        request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);

      // Account deletion runs through DELETE /api/me so every related document
      // (bookmarks, progress, notes, roadmaps) is removed too.
      allow delete: if false;

      // Saved AI roadmaps are private to the owner. The document lives at
      // users/{uid}/roadmaps/{roadmapId}, so the path itself is the access
      // boundary; the shape checks keep documents small and well-formed.
      match /roadmaps/{roadmapId} {
        allow read, delete: if isOwner(userId);
        allow create: if
          isOwner(userId) &&
          request.resource.data.keys().hasOnly([
            'userId', 'goal', 'level', 'language', 'title', 'summary', 'steps',
            'resourceIds', 'createdAt'
          ]) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.userId == userId &&
          isOptionalString(request.resource.data, 'summary', 1200) &&
          (!('resourceIds' in request.resource.data) ||
            (request.resource.data.resourceIds is list &&
              request.resource.data.resourceIds.size() <= 60)) &&
          isNonEmptyString(request.resource.data.goal) &&
          request.resource.data.goal.size() <= 300 &&
          isNonEmptyString(request.resource.data.title) &&
          request.resource.data.title.size() <= 200 &&
          request.resource.data.steps is list &&
          request.resource.data.steps.size() <= 20;
        allow update: if false;
      }

      // Private course notes, one document per (course, lesson). The body is
      // capped at 4,000 characters to keep documents small and cheap to sync.
      match /courseNotes/{noteId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if
          isOwner(userId) &&
          writesOnly([
            'id', 'userId', 'resourceId', 'videoId', 'videoTitle', 'body',
            'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.id == noteId &&
          request.resource.data.userId == userId &&
          isOptionalString(request.resource.data, 'videoTitle', 300) &&
          isNonEmptyString(request.resource.data.resourceId) &&
          request.resource.data.resourceId.size() <= 140 &&
          isNonEmptyString(request.resource.data.videoId) &&
          request.resource.data.videoId.size() <= 64 &&
          isNonEmptyString(request.resource.data.body) &&
          request.resource.data.body.size() <= 4000;
      }

      // Legacy personal saved resources: read-only now. New bookmarks (and
      // removals, which keep saveCount in sync) go through /api/bookmarks.
      match /bookmarks/{resourceId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ---------- bookmarks (userId_resourceId) ----------
    // Written only by the API (POST/DELETE /api/bookmarks/:resourceId), which
    // updates the resource's saveCount in the same transaction.
    match /bookmarks/{bookmarkId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ---------- progress (userId_resourceId) ----------
    match /progress/{progressId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if
        isSignedIn() &&
        writesOnly([
          'id', 'userId', 'resourceId', 'status', 'completedVideoIds', 'lastVideoId', 'updatedAt'
        ]) &&
        request.resource.data.id == progressId &&
        request.resource.data.userId == request.auth.uid &&
        progressId == ownedDocId(request.auth.uid, request.resource.data.resourceId) &&
        (!('status' in request.resource.data) ||
          request.resource.data.status in ['not_started', 'in_progress', 'completed']) &&
        isOptionalString(request.resource.data, 'lastVideoId', 128) &&
        (
          !('completedVideoIds' in request.resource.data) ||
          (
            request.resource.data.completedVideoIds is list &&
            request.resource.data.completedVideoIds.size() <= 5000
          )
        );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------- saved AI roadmaps (legacy top-level) ----------
    // New roadmaps live at users/{uid}/roadmaps. The old collection stays
    // readable and deletable by its owner for existing data, but clients can
    // never create or update top-level roadmaps any more.
    match /roadmaps/{roadmapId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if false;
    }

    // ---------- reviews ----------
    // Visible reviews are public. Hidden reviews are readable by their author
    // (so their own review still renders) and by admins; the public list query
    // must include `where('hidden', '==', false)`.
    //
    // All writes go through the API (POST /api/reviews, DELETE
    // /api/reviews/:resourceId): it checks email verification and that the
    // resource is published, sets the author name server-side, recomputes the
    // resource's ratingAvg/ratingCount in the same transaction, and refuses to
    // delete a hidden review (which would otherwise let an author re-post it).
    match /reviews/{reviewId} {
      allow read: if
        isAdmin() ||
        resource.data.get('hidden', false) == false ||
        (isSignedIn() && resource.data.userId == request.auth.uid);

      allow write: if false;
    }

    // ---------- reports ----------
    // Reports are created by the Express API with the Admin SDK (which bypasses
    // these rules), so the public client can never write here. Admin moderation
    // (status, notes, unpublish) also goes through the API so every change is
    // audited; clients only read the queue for counters and the dashboard.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ---------- audit trail (server-only) ----------
    // Admin actions are appended by the Express API with the Admin SDK. The
    // collection is never readable or writable from a browser — not even for
    // administrators — because the Admin SDK bypasses these rules.
    match /auditLogs/{entryId} {
      allow read, write: if false;
    }

    // ---------- settings ----------
    // settings/site is the only publicly readable settings document: the layout
    // reads the announcement banner and maintenance switch from it. Every
    // settings document is server-write only, and settings/ai (encrypted Groq
    // key and model) stays completely unreadable for clients.
    match /settings/{documentId} {
      allow read: if documentId == 'site';
      allow write: if false;
    }

    // ---------- default deny ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
