# ---------------------------------------------------------------------------
# Server runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080

# Comma-separated list of allowed browser origins. Include the Firebase Hosting
# domain and any custom domain. Never use "*" in production.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# ---------------------------------------------------------------------------
# Firebase Admin SDK (pick ONE credential option)
# ---------------------------------------------------------------------------
# Option A (recommended for Render/Railway/Cloud Run): paste the full service
# account JSON on ONE line inside .env. Keep the \n inside private_key escaped.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: three discrete values copied from the service-account JSON.
# Keep the \n sequences in FIREBASE_PRIVATE_KEY escaped (one line).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Option C: path to a service account JSON file (local development only).
GOOGLE_APPLICATION_CREDENTIALS=

# Optional explicit storage bucket (used for thumbnail uploads).
FIREBASE_STORAGE_BUCKET=

# Your own admin account(s). Used by scripts/set-admin.js and as a safety net.
ADMIN_EMAILS=jeyaulhoquejaber@gmail.com

# ---------------------------------------------------------------------------
# LearnMate AI — Groq (server-side only; never expose to the browser)
# Get a key from https://console.groq.com/keys
#
# IMPORTANT: these values belong in `server/.env`, NOT `client/.env`.
# Vite only exposes `VITE_*` variables to the browser, so a GROQ_API_KEY placed
# in the client env is invisible to this server (and would be unsafe there).
#
# This is the environment fallback. An admin can also store an encrypted key
# in Firestore via Admin → AI Settings — that key takes priority.
#
# Groq model names change over time. Check the current list at
# https://console.groq.com/docs/models before changing GROQ_MODEL.
# ---------------------------------------------------------------------------
GROQ_API_KEY=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
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_MS=15000
GROQ_MAX_OUTPUT_TOKENS=1024
GROQ_ROADMAP_MAX_OUTPUT_TOKENS=2048
AI_DAILY_LIMIT_PER_USER=10

# ---------------------------------------------------------------------------
# Settings encryption (required to save a Groq key from the admin panel)
# Generate with:  openssl rand -hex 32
# Used to AES-256-GCM encrypt secrets stored in Firestore `settings/ai`.
# Rotating this value makes previously stored keys undecryptable — clear and
# re-save the key in the admin panel after rotating.
# ---------------------------------------------------------------------------
SETTINGS_ENCRYPTION_KEY=a56dd5db7a720ef7c09abca8d19fee3eaccf27aa2d18a8e92ea37446ee313c8a

# ---------------------------------------------------------------------------
# Rate limits
# ---------------------------------------------------------------------------
REPORT_RATE_LIMIT_PER_HOUR=12
AI_RATE_LIMIT_PER_HOUR=25
ROADMAP_RATE_LIMIT_PER_HOUR=10
GLOBAL_RATE_LIMIT_PER_15_MIN=400
