# Firebase Web SDK configuration (Project settings -> General -> Your apps -> Config).
# Copy this file to .env and fill in the values. Never commit .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: enables Firebase Analytics (only loaded in production builds).
VITE_FIREBASE_MEASUREMENT_ID=

# Express API. In local development you can leave the proxy default.
# In production set the full HTTPS URL, e.g. https://openlearn-api.onrender.com
VITE_API_URL=http://localhost:8080

# Use the local Firebase Emulator Suite (auth 9099, firestore 8085, storage 9199).
VITE_USE_FIREBASE_EMULATOR=false

# Public contact details shown on legal and about pages
VITE_CONTACT_EMAIL=
VITE_LEGAL_EMAIL=
VITE_SITE_URL=
