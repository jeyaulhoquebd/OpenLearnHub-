# Firebase Web SDK configuration (Project settings -> General -> Your apps -> Config).
# Copy this file to .env and fill in the values. Never commit .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Optional and only used to keep legacy Firebase Storage image URLs working.
# New thumbnails are uploaded to Cloudinary instead.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: enables Firebase Analytics (only loaded in production builds).
VITE_FIREBASE_MEASUREMENT_ID=

# Express API. In local development you can leave the proxy default.
# In production set the full HTTPS URL, e.g. https://openlearn-api.onrender.com
VITE_API_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Cloudinary — unsigned image uploads (thumbnails)
# ---------------------------------------------------------------------------
# These values are public by design. NEVER put the Cloudinary API secret here.
# Preset settings: unsigned, overwrite off, no filename/unique-filename changes,
# asset folder is not used as a public-ID prefix, type=upload.
VITE_CLOUDINARY_CLOUD_NAME=y6fui3kz
VITE_CLOUDINARY_UPLOAD_PRESET=openlearnhub

# Use the local Firebase Emulator Suite (auth 9099, firestore 8085, storage 9199).
VITE_USE_FIREBASE_EMULATOR=false

# Public contact details shown on legal and about pages
VITE_CONTACT_EMAIL=
VITE_LEGAL_EMAIL=
VITE_SITE_URL=
