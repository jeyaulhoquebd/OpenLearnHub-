# Firebase Web SDK configuration (Project settings → General → Your apps → Config)
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Express API. In local development you can leave this empty and Vite proxies /api.
# In production set the full HTTPS URL, e.g. https://openlearn-api.onrender.com
VITE_API_URL=http://localhost:8080

# Use the local Firebase Emulator Suite (auth 9099, firestore 8085, storage 9199)
# Ports are defined in firebase.json. The API server keeps port 8080.
VITE_USE_FIREBASE_EMULATOR=false

# Public contact details shown on legal and about pages
VITE_CONTACT_EMAIL=hello@openlearnhub.org
VITE_LEGAL_EMAIL=legal@openlearnhub.org
VITE_SITE_URL=http://localhost:5173
